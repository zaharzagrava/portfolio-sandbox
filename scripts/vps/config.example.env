# Copy to ~/.config/sdd-vps/config.env (outside the repo) and fill in. chmod 600. Never commit the real file.
#   mkdir -p ~/.config/sdd-vps && cp scripts/vps/config.example.env ~/.config/sdd-vps/config.env && chmod 600 ~/.config/sdd-vps/config.env

# --- Hetzner Cloud: use a project that holds ONLY runner machines (the VM carries this token to delete itself)
HCLOUD_TOKEN=                 # Console -> your project -> Security -> API tokens -> Read & Write
HCLOUD_SSH_KEY=sdd            # name of your public SSH key as uploaded to that project
HCLOUD_LOCATION=fsn1          # a location where the type below exists: hcloud server-type describe ccx33
HCLOUD_SERVER_TYPE=ccx33      # 8 dedicated vCPU, 32 GB; ccx43 = 64 GB if you ever run out of memory
HCLOUD_FIREWALL=              # optional: name of a firewall that allows inbound TCP 22 only

# --- Claude: a long-lived login for headless use (valid one year). Run `claude setup-token` on your laptop.
CLAUDE_CODE_OAUTH_TOKEN=
# Never set ANTHROPIC_API_KEY for the runner: it would override the subscription and bill the API.

# --- Git: the VM clones, works on PUSH_BRANCH and pushes it; it never touches BASE_BRANCH
REPO_SSH_URL=git@github.com:zaharzagrava/portfolio-sandbox.git
DEPLOY_KEY_FILE=~/.ssh/sdd_deploy   # private key; its .pub is a WRITE deploy key of the repo. ssh-keygen -t ed25519 -N "" -f ~/.ssh/sdd_deploy
BASE_BRANCH=master            # a run starts from PUSH_BRANCH if it exists on origin, otherwise from this branch
PUSH_BRANCH=sdd/auto

# --- Phone notifications (ntfy.sh). Pick a long random topic and subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
HEARTBEAT_URL=                # optional dead-man's switch, e.g. a healthchecks.io check URL (pinged every minute)

# --- Run defaults (override per run with run-remote.sh options)
RUN_HOURS=5                   # hard end of the run; nothing starts after it and nothing outlives it
PASS_TIMEOUT_S=7200           # one claude call may not run longer than this
FAILURE_KEEP_MIN=120          # after a failure the VM stays this long so you can ssh in; it deletes itself afterwards
SNAPSHOT_MIN=15               # every N minutes the whole working tree (even uncommitted) is pushed to branch sdd/wip as a safety copy
GIT_AUTHOR_NAME="SDD runner"
GIT_AUTHOR_EMAIL=sdd-runner@users.noreply.github.com
