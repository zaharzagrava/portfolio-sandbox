# Copy to packages/backend/.env.test (git-ignored) to run e2e specs against
# docker-compose.test.yaml (project `marketplace_test`, ports shifted so the
# dev stack can run alongside). Dummy values for third parties: specs replace
# external side effects with jest spies (D5).
NODE_ENV=test
PORT=8400
DB_HOST=localhost
DB_PORT=5400
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace_test
SENTRY_DSN=https://public@sentry.invalid/1
APP_VERSION=test
JWT_SECRET=test-ws-ticket-secret
FRONT_HOST=http://localhost:3000
SHARE_LINK_CODE_KEY=test-share-link-code-key-0123456789abcdef
SHARE_LINK_EDGE_SECRET=test-share-link-edge-secret-0123456789abcd
SHARE_LINK_BASE_URL=https://mkt.to
# S36 sponsored listings: own click secret (>= 32 bytes, distinct from every other secret), thresholds, worker slot name
ADS_CLICK_SECRET=test-ads-click-secret-0123456789abcdefghij
# S42 public API: key-hash pepper (required, >= 32 bytes, distinct from every other secret)
API_KEY_PEPPER=test-api-key-pepper-0123456789abcdefghijkl
ADS_SPAM_IP_PER_MINUTE=20
ADS_SPAM_REPEAT_PER_HOUR=3
ADS_AGGREGATOR_INSTANCE=test-0
BACKEND_HOST=http://localhost:8400
FIREBASE_CLIENT_EMAIL=test@test.invalid
FIREBASE_PRIVATE_KEY=test
FIREBASE_PROJECT_ID=test
FIREBASE_WEB_API_KEY=test
KAFKA_BROKER=localhost:9192
KAFKA_API_KEY=test
KAFKA_API_SECRET=test
REDIS_URL=redis://localhost:6400/0
CHAT_WS_URL=ws://localhost:8490
ELASTICSEARCH_NODE=http://localhost:9300
CLICKHOUSE_URL=http://localhost:8223
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=marketplace_test
STRIPE_SECRET_KEY=sk_test_dummy

S3_ENDPOINT=http://localhost:9210
MEDIA_BUCKET=marketplace-media-test
# S29: the media origin (a different site from the app and the API in production) and the scanner switch
MEDIA_CDN_URL=https://media.marketplace-test.example
MEDIA_SCANNER_DISABLED=true
# S30: video delivery host (https, a different site from the app and the API) and the parent cookie domain holding both; signing key pair (set by the harness, unset = unlisted playback answers 503)
VIDEO_CDN_URL=https://stream.marketplace-test.example
VIDEO_COOKIE_DOMAIN=.marketplace-test.example
SQS_ENDPOINT=http://localhost:9424
SQS_QUEUE_URL_PREFIX=http://localhost:9424/000000000000/
DYNAMO_ENDPOINT=http://localhost:8101
DYNAMO_TABLE_PREFIX=test_
CASSANDRA_CONTACT_POINTS=localhost:9142
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=marketplace
NOTIFICATION_SECRET=test-notifications
SMTP_URL=smtp://localhost:1125

# Test MinIO / DynamoDB local / ElasticMQ accept these; never use real AWS keys in tests.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
