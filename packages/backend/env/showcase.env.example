# Showcase program (docs/showcase) — append to your local .env. All optional.
LOAD_SHEDDING_LAG_MS=200
CORS_ALLOWED_ORIGINS=http://localhost:3000
S3_ENDPOINT=http://localhost:9100
MEDIA_BUCKET=marketplace-media
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_URL_PREFIX=http://localhost:9324/000000000000/
DYNAMO_ENDPOINT=http://localhost:8100
DYNAMO_TABLE_PREFIX=local_
CASSANDRA_CONTACT_POINTS=localhost:9042
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=marketplace

# SD-17 notifications. Without SES/Twilio/Firebase creds: SMTP → Mailpit (http://localhost:8025), SMS/push logged.
NOTIFICATION_SECRET=change-me-notifications
SMTP_URL=smtp://localhost:1025
SES_FROM_ADDRESS=
SES_EVENTS_TOPIC_ARN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SD-16 collab instances (apps/collab). Each instance advertises its own URL in the hash ring.
COLLAB_PUBLIC_URL=ws://localhost:8020
COLLAB_INSTANCE_ID=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
