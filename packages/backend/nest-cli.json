{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/core/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "typeCheck": false,
    "tsConfigPath": "apps/core/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/core",
  "projects": {
    "bff": {
      "type": "application",
      "root": "apps/bff",
      "entryFile": "main",
      "sourceRoot": "apps/bff/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bff/tsconfig.app.json"
      }
    },
    "collab": {
      "type": "application",
      "root": "apps/collab",
      "entryFile": "main",
      "sourceRoot": "apps/collab/src",
      "compilerOptions": {
        "tsConfigPath": "apps/collab/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "application",
      "root": "apps/core",
      "entryFile": "main",
      "sourceRoot": "apps/core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/core/tsconfig.app.json"
      }
    },
    "lambda-local": {
      "type": "application",
      "root": "apps/lambda-local",
      "entryFile": "main",
      "sourceRoot": "apps/lambda-local/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lambda-local/tsconfig.app.json"
      }
    },
    "lambdas": {
      "type": "application",
      "root": "apps/lambdas",
      "entryFile": "lambdas.manifest",
      "sourceRoot": "apps/lambdas/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lambdas/tsconfig.app.json"
      }
    },
    "local-monolith": {
      "type": "application",
      "root": "apps/local-monolith",
      "entryFile": "main",
      "sourceRoot": "apps/local-monolith/src",
      "compilerOptions": {
        "tsConfigPath": "apps/local-monolith/tsconfig.app.json"
      }
    },
    "payment-processor": {
      "type": "application",
      "root": "apps/payment-processor",
      "entryFile": "main",
      "sourceRoot": "apps/payment-processor/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payment-processor/tsconfig.app.json"
      }
    },
    "projector": {
      "type": "application",
      "root": "apps/projector",
      "entryFile": "main",
      "sourceRoot": "apps/projector/src",
      "compilerOptions": {
        "tsConfigPath": "apps/projector/tsconfig.app.json"
      }
    },
    "public-api": {
      "type": "application",
      "root": "apps/public-api",
      "entryFile": "main",
      "sourceRoot": "apps/public-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/public-api/tsconfig.app.json"
      }
    },
    "sse-gateway": {
      "type": "application",
      "root": "apps/sse-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/sse-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sse-gateway/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    }
  }
}