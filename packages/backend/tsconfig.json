{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/infrastructure/*": [
        "libs/infrastructure/*"
      ],
      "@app/composition/*": [
        "libs/composition/*"
      ],
      "@app/domains/*": [
        "libs/domains/*"
      ],
      "@app/test/*": [
        "test/*"
      ],
      "@app/common/*": [
        "libs/common/*"
      ],
      "@app/core/*": [
        "apps/core/src/*"
      ],
      "@app/bff/*": [
        "apps/bff/src/*"
      ],
      "@app/sse-gateway/*": [
        "apps/sse-gateway/src/*"
      ],
      "@app/worker/*": [
        "apps/worker/src/*"
      ],
      "@app/projector/*": [
        "apps/projector/src/*"
      ],
      "@app/collab/*": [
        "apps/collab/src/*"
      ],
      "@app/public-api/*": [
        "apps/public-api/src/*"
      ]
    }
  }
}