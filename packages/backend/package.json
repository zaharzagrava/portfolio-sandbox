{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "check:module-graph": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register -r tsconfig-paths/register scripts/check-module-graph.ts",
    "check:table-ownership": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register scripts/check-table-ownership.ts",
    "check:model-registry": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register -r tsconfig-paths/register scripts/check-model-registry.ts",
    "test:journeys": "jest --config jest-journeys.json --runInBand",
    "check:boundaries": "depcruise apps libs test db --config .dependency-cruiser.cjs --output-type err",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "cleanup": "docker volume prune -f && docker network prune -f && docker stop $(docker ps -a -q) || true && docker rm $(docker ps -a -q) || true",
    "start": "NODE_ENV=local nest start",
    "start:load-test": "NODE_ENV=local IS_LOAD_TEST=true nest start --watch --exec \"node --require ./dist/tracing.js\"",
    "start:load-test:clean": "NODE_ENV=local IS_LOAD_TEST=true nest start --watch --exec \"node --require ./dist/tracing.js\"",
    "start:debug:tracing": "NODE_ENV=local nest start --watch --exec \"node --inspect=0.0.0.0:9229 --require ./dist/tracing.js\"",
    "start:prod:tracing": "node --require ./dist/tracing.js dist/main",
    "start:dev": "NODE_ENV=local nest start --watch",
    "start:dev:payment-processor": "NODE_ENV=local nest start payment-processor --watch",
    "start:dev:sse-gateway": "NODE_ENV=local PORT=8001 nest start sse-gateway --watch",
    "build:payment-processor": "nest build payment-processor",
    "build:sse-gateway": "nest build sse-gateway",
    "start:debug": "NODE_ENV=local nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/apps/core/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./jest-e2e.json --runInBand",
    "db:drop": "npx sequelize-cli db:drop",
    "db:create": "npx sequelize-cli db:create",
    "db:migrate:create": "npx sequelize-cli migration:generate --name $1",
    "db:migrate:up": "npx sequelize-cli db:migrate",
    "db:migrate:down": "npx sequelize-cli db:migrate:undo",
    "db:jest:migrate:up": "npx sequelize-cli db:migrate --env test",
    "test:run": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:debug:run": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest \"impossible-regex\" --watch --runInBand",
    "kafka:topics:init": "bash ./scripts/init-kafka-topics.sh",
    "infra:setup": "pnpm run kafka:topics:init && pnpm run db:migrate:up && pnpm run cql:migrate && pnpm run dynamo:create-tables && pnpm run clickhouse:migrate",
    "clickhouse:migrate": "ts-node -r tsconfig-paths/register scripts/clickhouse/migrate.ts",
    "loadtest:seed": "node scripts/load-tests/seed/index.js",
    "loadtest:payment": "k6 run scripts/load-tests/payment.test.js",
    "loadtest:search": "k6 run scripts/load-tests/search.test.js",
    "loadtest:seller-stats": "k6 run scripts/load-tests/seller-stats.test.js",
    "loadtest:chat": "k6 run scripts/load-tests/chat.test.js",
    "cql:migrate": "ts-node -r tsconfig-paths/register scripts/cql/migrate.ts",
    "dynamo:create-tables": "ts-node -r tsconfig-paths/register scripts/dynamo/create-tables.ts",
    "test:e2e:infra-up": "docker compose -f ../../docker-compose.test.yaml -p marketplace_test up -d && pnpm run db:jest:migrate:up",
    "start:dev:projector": "NODE_ENV=local PORT=8002 nest start projector --watch",
    "build:projector": "nest build projector",
    "projections:rebuild": "ts-node -r tsconfig-paths/register scripts/projections/rebuild.ts",
    "slo:generate": "ts-node scripts/slo/generate.ts",
    "rag:eval": "ts-node -r tsconfig-paths/register scripts/rag-eval/rag-eval.ts",
    "loadtest:sse": "k6 run scripts/load-tests/sse.test.js",
    "start:dev:worker": "NODE_ENV=local PORT=8003 nest start worker --watch",
    "build:worker": "nest build worker",
    "loadtest:jobs": "node scripts/load-tests/jobs-drain.js",
    "loadtest:ratelimit": "k6 run scripts/load-tests/ratelimit.test.js",
    "loadtest:product-detail": "k6 run scripts/load-tests/product-detail.test.js",
    "loadtest:flash-sale": "k6 run scripts/load-tests/flash-sale.test.js",
    "loadtest:launch-event": "k6 run scripts/load-tests/launch-event.test.js",
    "loadtest:auction": "k6 run scripts/load-tests/auction.test.js",
    "start:dev:collab": "NODE_ENV=local PORT=8004 nest start collab --watch",
    "start:dev:public-api": "NODE_ENV=local PORT=8005 nest start public-api --watch",
    "start:dev:bff": "NODE_ENV=local PORT=8006 CORE_INTERNAL_URL=http://localhost:8000 nest start bff --watch",
    "start:dev:monolith": "NODE_ENV=local CORE_INTERNAL_URL=http://localhost:8000 nest start local-monolith --watch",
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "start:lambda-local": "nest build lambda-local && node dist/apps/lambda-local/main.js",
    "seed:dev": "ts-node -r tsconfig-paths/register scripts/seed/dev-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-dynamodb": "^3.1143.0",
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/client-secrets-manager": "^3.1005.0",
    "@aws-sdk/client-sesv2": "^3.1143.0",
    "@aws-sdk/client-sqs": "^3.1143.0",
    "@aws-sdk/cloudfront-signer": "^3.1005.0",
    "@aws-sdk/lib-dynamodb": "^3.1143.0",
    "@aws-sdk/lib-storage": "^3.1143.0",
    "@aws-sdk/s3-presigned-post": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@clickhouse/client": "^1.11.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@marketplace-sandbox/contracts": "workspace:*",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/microservices": "^11.1.16",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-prometheus": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nestjs": "^10.43.0",
    "@sentry/node": "^10.75.0",
    "@sentry/profiling-node": "^10.43.0",
    "argon2": "^0.45.1",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cassandra-driver": "^4.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1.1.1",
    "cron": "^4.4.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dataloader": "^2.2.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "firebase-admin": "^13.7.0",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "isolated-vm": "^7.0.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "lib0": "^0.2.119",
    "lodash": "^4.17.23",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "marked": "^18.0.14",
    "nestjs-cls": "^7.0.1",
    "nestjs-otel": "^8.0.2",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^7.0.13",
    "openid-client": "^6.8.8",
    "opossum": "^8.1.4",
    "otplib": "^13.5.0",
    "pg": "^8.20.0",
    "pg-query-stream": "^4.17.0",
