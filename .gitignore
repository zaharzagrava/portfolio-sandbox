# Environment variables
.env
.env.*

.ua

# moon
.moon/cache
.moon/docker

# pnpm
node_modules

# codebase-memory-mcp - regenerated locally, tied to current code state
.codebase-memory/

# cargo
target/

# Terraform (O-03)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
crash.log
infra/modules/lambda_sqs_worker/.placeholder.zip

.obsidian/
.aider*

# SDD loop scratch (per spec): step logs only. The step markers (.plan.done ...) and the baselines (.ownership.baseline,
# .tx.baseline) are NOT ignored: they are state, and a run that resumes the branch on another machine needs them.
specs/**/.*.log

# SDD monitor state and progress log
.sdd-monitor/
specs/.checkpoints/*.log
specs/.checkpoints/*.jsonl

# Python bytecode of the scripts
__pycache__/

# QA agent: the reports (*.md) and the scripts it wrote stay in git (the ledger and select.py read them); screenshots and traces do not
specs/.qa/**/*.png
specs/.qa/**/*.webm
specs/.qa/**/*.zip
docker-compose.shard*.yaml
packages/backend/.env.test.shard*
specs/.checkpoints/speedup-*.txt
specs/.checkpoints/sharded/
specs/.checkpoints/*.json
specs/.checkpoints/*.md
specs/.checkpoints/qa-monkey/
specs/.checkpoints/qa-fuzz/
specs/.checkpoints/qa-seller/

# Stryker mutation testing scratch folders
.stryker-tmp/
.web-aiqa-copy/
specs/.checkpoints/coverage/

# AI QA throwaway browser scripts written by agents
packages/web/aiqa-*.cjs
packages/web/live*.cjs
packages/web/aiqa-*.png
packages/web/live*.png

# AI QA generated reports (run output, not baselines); maps, fingerprints and snapshots stay tracked
scripts/aiqa/coverage/*.unexecuted.md
scripts/aiqa/coverage/*.lock
