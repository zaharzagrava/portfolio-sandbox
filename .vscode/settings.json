{
  "eslint.alwaysShowStatus": true,
  // Prettier is off in the editor for now: the implementation loop writes unformatted code, and saving a file
  // would otherwise rewrite it. To bring it back, set formatOnSave to true and delete the customization below.
  "editor.formatOnSave": false,
  // "editor.defaultFormatter": "esbenp.prettier-vscode",
  // The source.fixAll action below also applies Prettier through eslint-plugin-prettier; ignore that one rule.
  "eslint.rules.customizations": [
    { "rule": "prettier/prettier", "severity": "off" }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.workingDirectories": [
    "backend"
  ],
  "files.associations": {
    "Dockerfile-prod": "dockerfile",
    ".env.prod": "properties",
    "wrangler.json": "jsonc"
  },
  "debug.javascript.terminalOptions": {
    "skipFiles": [
      "./node_modules/**/*.js",
      "./backend/node_modules/**/*.js",
      "<node_internals>/**/*.js",
      "<node_internals>/**",
    ]
  },
  "typescript.tsdk": "./packages/backend/node_modules/typescript/lib",
  "js/ts.tsdk.path": "./packages/backend/node_modules/typescript/lib",
}